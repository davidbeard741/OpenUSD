{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# 🚀 Improved OpenUSD Hero Shot for Blender\n",
        "Better scale, geometry, and lighting — perfect for Blender import."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "!pip install usd-core --quiet\n",
        "from pxr import Usd, UsdGeom, UsdLux, UsdShade, Sdf, Gf\n",
        "from google.colab import files\n",
        "print(\"✅ Ready\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "stage = Usd.Stage.CreateNew(\"better_file.usd\")\n",
        "\n",
        "# Hero Lantern - Larger and more detailed\n",
        "hero = UsdGeom.Xform.Define(stage, \"/World/Hero/Lantern\")\n",
        "Usd.ModelAPI(hero.GetPrim()).SetKind(\"component\")\n",
        "\n",
        "body = UsdGeom.Mesh.Define(stage, \"/World/Hero/Lantern/Body\")\n",
        "body.CreatePointsAttr().Set([\n",
        "    (-1,-1,0), (1,-1,0), (1,1,0), (-1,1,0),\n",
        "    (-1.2,-1.2,3), (1.2,-1.2,3), (1.2,1.2,3), (-1.2,1.2,3)\n",
        "])\n",
        "body.CreateFaceVertexCountsAttr().Set([4,4,4,4,4,4])\n",
        "body.CreateFaceVertexIndicesAttr().Set([0,1,5,4, 1,2,6,5, 2,3,7,6, 3,0,4,7, 4,5,6,7, 0,3,2,1])\n",
        "\n",
        "# Primvar color\n",
        "pv = UsdGeom.PrimvarsAPI(body).CreatePrimvar(\"displayColor\", Sdf.ValueTypeNames.Color3fArray, UsdGeom.Tokens.vertex)\n",
        "pv.Set([(0.9,0.6,0.2)]*8)\n",
        "\n",
        "# Material\n",
        "mat = UsdShade.Material.Define(stage, \"/World/Materials/Lantern\")\n",
        "shader = UsdShade.Shader.Define(stage, \"/World/Materials/Lantern/Preview\")\n",
        "shader.CreateIdAttr(\"UsdPreviewSurface\")\n",
        "shader.CreateInput(\"diffuseColor\", Sdf.ValueTypeNames.Color3f).Set((0.8, 0.7, 0.5))\n",
        "shader.CreateInput(\"metallic\", Sdf.ValueTypeNames.Float).Set(0.85)\n",
        "UsdShade.MaterialBindingAPI.Apply(hero.GetPrim()).Bind(mat)\n",
        "\n",
        "print(\"✅ Lantern created\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Stronger lights\n",
        "key = UsdLux.SphereLight.Define(stage, \"/World/Lights/KeyLight\")\n",
        "key.CreateIntensityAttr().Set(80000)\n",
        "key.CreateRadiusAttr().Set(3)\n",
        "key.AddTranslateOp().Set(Gf.Vec3d(10, 15, 12))\n",
        "\n",
        "fill = UsdLux.SphereLight.Define(stage, \"/World/Lights/FillLight\")\n",
        "fill.CreateIntensityAttr().Set(30000)\n",
        "fill.CreateRadiusAttr().Set(4)\n",
        "fill.AddTranslateOp().Set(Gf.Vec3d(-12, 8, -8))\n",
        "\n",
        "print(\"✅ Lighting improved\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Camera\n",
        "cam = UsdGeom.Camera.Define(stage, \"/World/Camera/ShotCamera\")\n",
        "cam.CreateFocalLengthAttr().Set(50)\n",
        "xform = UsdGeom.Xformable(cam.GetPrim())\n",
        "xform.ClearXformOpOrder()\n",
        "xform.AddTranslateOp().Set(Gf.Vec3d(12, 10, 18))\n",
        "xform.AddRotateXYZOp().Set(Gf.Vec3f(-28, 38, 0))\n",
        "\n",
        "print(\"✅ Camera set\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Large ground + better trees\n",
        "ground = UsdGeom.Mesh.Define(stage, \"/World/Ground\")\n",
        "ground.CreatePointsAttr().Set([(-50,0,-50),(50,0,-50),(50,0,50),(-50,0,50)])\n",
        "ground.CreateFaceVertexCountsAttr().Set([4])\n",
        "ground.CreateFaceVertexIndicesAttr().Set([0,1,2,3])\n",
        "\n",
        "# Simple but visible trees\n",
        "for i in range(12):\n",
        "    tree = UsdGeom.Xform.Define(stage, f\"/World/Trees/Tree_{i:02d}\")\n",
        "    prim = tree.GetPrim()\n",
        "    prim.GetReferences().AddReference(stage.GetRootLayer().identifier, \"/World/Prototypes/Tree\")\n",
        "    prim.SetInstanceable(True)\n",
        "    tree.AddTranslateOp().Set(Gf.Vec3d(i*6-30, 0, (i%5)*8-15))\n",
        "\n",
        "# Prototype tree\n",
        "proto = UsdGeom.Mesh.Define(stage, \"/World/Prototypes/Tree\")\n",
        "proto.CreatePointsAttr().Set([(0,0,0),(0,4,0),(1,3,0),(-1,3,0)])\n",
        "proto.CreateFaceVertexCountsAttr().Set([3,3])\n",
        "proto.CreateFaceVertexIndicesAttr().Set([0,1,2, 0,1,3])\n",
        "\n",
        "print(\"✅ Ground + Trees created\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "stage.Save()\n",
        "print(\"✅ better_file.usd saved!\")\n",
        "files.download(\"better_file.usd\")"
      ]
    }
  ],
  "metadata": { ... },
